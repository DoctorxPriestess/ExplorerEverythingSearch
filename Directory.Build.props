<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.0</Version>
    <Authors>Explorer Everything Search contributors</Authors>
    <Product>Explorer Everything Search</Product>
    <Description>Redirects Windows Explorer search to Everything.</Description>
    <RepositoryType>git</RepositoryType>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Windows-only product; suppress the platform-compatibility analyzer noise for Win32 usage. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
