<Window x:Class="ExplorerEverythingSearch.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorer Everything Search"
        Width="640"
        SizeToContent="Height"
        MaxHeight="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="RootLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,12,4" VerticalAlignment="Center" />
            <TextBlock x:Name="RootValue" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="ConfigLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,12,4" VerticalAlignment="Center" />
            <TextBlock x:Name="ConfigValue" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,4" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <Separator Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,10" />

            <CheckBox x:Name="EnabledCheck" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />
            <CheckBox x:Name="ReuseWindowCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />
            <CheckBox x:Name="EnterFocusCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />
            <CheckBox x:Name="EnterCommitCheck" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />

            <TextBlock x:Name="DelayLabel" Grid.Row="7" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="DelayBox" Grid.Row="7" Grid.Column="1" Margin="0,0,8,8" />

            <TextBlock x:Name="EnterWindowLabel" Grid.Row="8" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="EnterWindowBox" Grid.Row="8" Grid.Column="1" Margin="0,0,8,8" />

            <TextBlock x:Name="RescanLabel" Grid.Row="9" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="RescanBox" Grid.Row="9" Grid.Column="1" Margin="0,0,8,8" />

            <TextBlock x:Name="EverythingPathLabel" Grid.Row="10" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="EverythingPathBox" Grid.Row="10" Grid.Column="1" Margin="0,0,8,8" />
            <Button x:Name="BrowseEverythingButton" Grid.Row="10" Grid.Column="2" Margin="0,0,0,8" Padding="10,2" Click="BrowseEverything_Click" />

            <TextBlock x:Name="EsPathLabel" Grid.Row="11" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="EsPathBox" Grid.Row="11" Grid.Column="1" Margin="0,0,8,8" />
            <Button x:Name="BrowseEsButton" Grid.Row="11" Grid.Column="2" Margin="0,0,0,8" Padding="10,2" Click="BrowseEs_Click" />

            <TextBlock x:Name="DetectionLabel" Grid.Row="12" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBlock x:Name="DetectionValue" Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="StartupCheck" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4" />
            <TextBlock x:Name="StartupStaleText" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                       Foreground="#B45309" TextWrapping="Wrap" Visibility="Collapsed" />
            <Button x:Name="StartupRepairButton" Grid.Row="14" Grid.Column="2" Margin="0,0,0,8" Padding="10,2"
                    Click="RepairStartup_Click" Visibility="Collapsed" />

            <CheckBox x:Name="NotificationsCheck" Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />
            <CheckBox x:Name="LoggingCheck" Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8" />

            <TextBlock x:Name="LogLevelLabel" Grid.Row="17" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <ComboBox x:Name="LogLevelCombo" Grid.Row="17" Grid.Column="1" Margin="0,0,8,8" />

            <TextBlock x:Name="MaxLogSizeLabel" Grid.Row="18" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
            <TextBox x:Name="MaxLogSizeBox" Grid.Row="18" Grid.Column="1" Margin="0,0,8,8" />

            <TextBlock x:Name="LanguageLabel" Grid.Row="19" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageCombo" Grid.Row="19" Grid.Column="1" Margin="0,0,8,10" />

            <StackPanel Grid.Row="20" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="TestButton" Margin="0,0,8,0" Padding="10,3" Click="TestConnection_Click" />
                <Button x:Name="OpenLogsButton" Margin="0,0,8,0" Padding="10,3" Click="OpenLogs_Click" />
                <Button x:Name="ClearLogsButton" Margin="0,0,8,0" Padding="10,3" Click="ClearLogs_Click" />
                <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#0F766E" />
            </StackPanel>

            <StackPanel Grid.Row="21" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="SaveButton" Margin="0,0,8,0" Padding="18,4" Click="Save_Click" />
                <Button x:Name="CancelButton" Padding="18,4" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
